{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "execution": "data",
  "id": "zh-cn",
  "name": "简体中文",
  "version": "1.0.0",
  "description": "完整的简体中文界面语言包：补全 Orca 内置中文缺失的条目，并统一 agent、tab 等术语的译法。",
  "license": "MIT",
  "author": {
    "name": "jiaonang",
    "url": "https://github.com/jiaonang"
  },
  "repository": "https://github.com/jiaonang/orca-chinese",
  "homepage": "https://github.com/jiaonang/orca-chinese",
  "engines": {
    "orca": ">=1.4.246"
  },
  "capabilities": [],
  "contributes": {
    "languagePacks": [
      {
        "locale": "zh",
        "path": "locales/zh.json",
        "displayName": "简体中文（社区）"
      }
    ]
  }
}
